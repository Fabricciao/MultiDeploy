# Supabase (local : `supabase start` affiche ces valeurs)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Uniquement côté serveur, JAMAIS exposée au navigateur
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Postgres direct (pooler Supabase en prod ; en dev : bash supabase/dev-db.sh up)
DATABASE_URL=postgresql://postgres@127.0.0.1:54330/multideploy
# E-mails : sans clé, les envois sont enregistrés en « dry_run »
RESEND_API_KEY=
EMAIL_FROM="Eliezer.immo <no-reply@example.com>"

# ── IA (toutes optionnelles : sans clé, les fonctions concernées sont désactivées proprement) ──
# Transcription vocale + retouche d'image (OpenAI) : les NOMS DE MODÈLES sont à renseigner, rien n'est présumé
OPENAI_API_KEY=
OPENAI_STT_MODEL=
OPENAI_IMAGE_MODEL=
# Extraction structurée + lecture de documents manuscrits (Anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Stockage : local en dev (apps/web/.data) ; en prod Supabase Storage (bucket privé) si la clé service est présente
STORAGE_BUCKET=agency-files
# Rendu d'affiches : chemin de Chromium si différent de celui de Playwright (conteneur dédié en production)
CHROMIUM_PATH=
POSTER_CONCURRENCY=2
