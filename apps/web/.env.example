# Supabase (local : `supabase start` affiche ces valeurs)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Uniquement côté serveur, JAMAIS exposée au navigateur
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Postgres direct (pooler Supabase en prod ; en dev : bash supabase/dev-db.sh up)
DATABASE_URL=postgresql://postgres@127.0.0.1:54330/multideploy
# E-mails : sans clé, les envois sont enregistrés en « dry_run »
RESEND_API_KEY=
EMAIL_FROM="Eliezer.immo <no-reply@example.com>"

# ── IA (toutes optionnelles : sans clé, les fonctions concernées sont désactivées proprement) ──
# Transcription vocale + retouche d'image (OpenAI) : les NOMS DE MODÈLES sont à renseigner, rien n'est présumé
OPENAI_API_KEY=
OPENAI_STT_MODEL=
OPENAI_IMAGE_MODEL=
# Extraction structurée + lecture de documents manuscrits (Anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Stockage : local en dev (apps/web/.data) ; en prod Supabase Storage (bucket privé) si la clé service est présente
STORAGE_BUCKET=agency-files
# Rendu d'affiches : chemin de Chromium si différent de celui de Playwright (conteneur dédié en production)
CHROMIUM_PATH=
POSTER_CONCURRENCY=2

# ── Sécurité / secrets applicatifs (OBLIGATOIRES en production) ──
# CRON_SECRET : jeton des routes /api/cron/* (Vercel l'envoie en « Authorization: Bearer » s'il est défini)
CRON_SECRET=
# APP_SECRET : signature des liens (bon de visite, URLs publiques d'affiches, état OAuth). 32+ caractères aléatoires.
APP_SECRET=
# INTEGRATIONS_KEY : chiffrement AES-256-GCM des jetons WhatsApp/Meta/Google en base. 32 octets en base64 :  openssl rand -base64 32
# ⚠ Perdre cette clé rend les connexions illisibles (à reconnecter) ; la changer invalide les connexions existantes.
INTEGRATIONS_KEY=
# Domaines racine des agences en sous-domaine (ex. multideploy.app) : acme.multideploy.app → agence « acme »
APP_DOMAINS=

# ── Facturation Stripe (optionnelle tant que les plans ne sont pas vendus) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── WhatsApp Cloud API / Facebook / Instagram (Meta) ──
# Les jetons PAR AGENCE se saisissent dans Réglages → Connexions. Ci-dessous : l'application Meta de la plateforme.
META_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0
# META_GRAPH_BASE=            # uniquement pour les tests (faux serveur Graph)

# ── Google Agenda (OAuth « application Web », portée calendar.events) ──
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Rendu déporté (production Vercel) : service apps/renderer sur un hébergeur de conteneurs ──
POSTER_RENDER_URL=
POSTER_RENDER_TOKEN=

# ── Facturation ──
# manual (défaut) : aucun paiement dans le CRM ; la plateforme fixe plan et échéance. stripe : réactive le paiement Stripe (non utilisé).
BILLING_MODE=manual

# ── Fournisseurs IA alternatifs (optionnels, remplacent ou complètent les clés ci-dessus) ──
# Texte (extraction, traduction) via un service compatible OpenAI « chat/completions » : DeepSeek, OpenAI, Groq, Mistral, Ollama…
# LLM_PROVIDER=openai_compat
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=
# LLM_MODEL=                 # nom du modèle à vérifier chez le fournisseur
# LLM_VISION_MODEL=          # uniquement si le fournisseur lit les images ; sinon ANTHROPIC_API_KEY sert à la lecture de papiers manuscrits
# Transcription vocale : tout service compatible « /audio/transcriptions » (OpenAI, Groq, faster-whisper-server auto-hébergé)
# STT_BASE_URL=https://api.groq.com/openai/v1
# STT_API_KEY=
# STT_MODEL=
