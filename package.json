{
  "name": "multideploy",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @multideploy/web dev",
    "build": "pnpm --filter @multideploy/web build",
    "lint": "pnpm --filter @multideploy/web lint",
    "typecheck": "pnpm --filter @multideploy/web typecheck",
    "test": "pnpm --filter @multideploy/web test",
    "test:db": "bash supabase/tests/run.sh",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:db",
    "db:dev": "bash supabase/dev-db.sh up",
    "db:reset": "bash supabase/dev-db.sh reset",
    "db:stop": "bash supabase/dev-db.sh stop",
    "e2e": "node apps/web/e2e/phase1.cjs"
  }
}
